<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <ProjectReference Include="../SawContainerGuard.csproj" Condition="Exists('../SawContainerGuard.csproj')" />
    <Reference Include="VintagestoryAPI"><HintPath>$(GamePath)/VintagestoryAPI.dll</HintPath></Reference>
    <Reference Include="VSSurvivalMod"><HintPath>$(GamePath)/Mods/VSSurvivalMod.dll</HintPath></Reference>
    <Reference Include="VSEssentials"><HintPath>$(GamePath)/Mods/VSEssentials.dll</HintPath></Reference>
    <Reference Include="0Harmony"><HintPath>$(GamePath)/Lib/0Harmony.dll</HintPath></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(GamePath)/Lib/Newtonsoft.Json.dll</HintPath></Reference>
    <None Include="$(GamePath)/Lib/*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(GamePath)/VintagestoryLib.dll" Link="VintagestoryLib.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
